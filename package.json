{
  "name": "reforgiparse",
  "version": "0.7.0",
  "description": "Static analysis for ForgeScript bots: a parser that matches ForgeScript's compiler, checks with the bot's own functions, safe fixes, and a language server.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "dist/core.d.ts"
      ]
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.js",
    "parity": "tsc && node --test test/parity.test.js test/positions.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demonic1594/ReForgiParse.git"
  },
  "homepage": "https://github.com/Demonic1594/ReForgiParse#readme",
  "bugs": {
    "url": "https://github.com/Demonic1594/ReForgiParse/issues"
  },
  "keywords": [
    "ast",
    "discord",
    "forgescript",
    "language-server",
    "linter",
    "lsp",
    "parser",
    "tryforge"
  ],
  "license": "LGPL-3.0-or-later",
  "engines": {
    "node": ">=18.17"
  },
  "peerDependencies": {
    "@tryforge/forgescript": ">=2.5.0"
  },
  "peerDependenciesMeta": {
    "@tryforge/forgescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tryforge/forgescript": "2.8.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3"
  },
  "bin": {
    "reforgiparse": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  }
}
