{
  "name": "reforgiparse",
  "version": "0.4.0",
  "description": "Checks ForgeScript bots the way ForgeScript compiles them: a parser with the same tree and errors as ForgeScript's own compiler, source positions, error recovery, and a command-line check of a whole bot.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.js",
    "parity": "tsc && node --test test/parity.test.js test/positions.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demonic1594/ReForgiParse.git"
  },
  "keywords": [
    "forgescript",
    "parser",
    "ast",
    "discord",
    "tryforge"
  ],
  "license": "LGPL-3.0-or-later",
  "engines": {
    "node": ">=18.17"
  },
  "peerDependencies": {
    "@tryforge/forgescript": ">=2.5.0"
  },
  "peerDependenciesMeta": {
    "@tryforge/forgescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tryforge/forgescript": "2.8.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3"
  },
  "bin": {
    "reforgiparse": "dist/cli.js"
  }
}
